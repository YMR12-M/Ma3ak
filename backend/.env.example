PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ma3ak
# TLS للاتصال بالداتابيز — لازم true مع الخدمات المُدارة (Aiven وأمثالها).
# لو شهادة الخدمة مش من جهة معروفة: NODE_EXTRA_CA_CERTS=/path/to/ca.pem
# DB_SSL=true

# غيّر السطر ده لأي نص عشوائي طويل قبل ما تشتغل في الإنتاج
JWT_SECRET=change-this-to-a-long-random-string

# ---------- إشعارات الدفع (Web Push) ----------
# من غير المفاتيح دي التطبيق بيشتغل عادي، بس التذكير مش هيوصل والتطبيق مقفول
# (وده الوضع الطبيعي 99% من الوقت) - يعني أهم ميزة في التطبيق هتبقى معطّلة.
#
# ولّد زوج مفاتيح مرة واحدة بس بالأمر ده، وحطهم هنا:
#   npx web-push generate-vapid-keys
#
# مهم: لو غيّرت المفاتيح دي بعد ما ناس اشتركت، كل الاشتراكات القديمة بتبطل
# وكل مستخدم لازم يفعّل التنبيهات من الأول. متغيّرهاش من غير سبب.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# وسيلة تواصل معاك كصاحب السيرفر - خدمات الدفع بتطلبها في المواصفة عشان
# تقدر تبلّغك لو سيرفرك بيبعت غلط. mailto: أو https:
VAPID_SUBJECT=mailto:you@example.com
