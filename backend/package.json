{
  "name": "ma3ak-backend",
  "version": "1.0.0",
  "description": "معاك (MA3ak) - منصة متابعة كبار السن - Backend API",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "npm run build && node --watch server.js",
    "build": "node ../frontend/build.js",
    "build:watch": "node ../frontend/build.js --watch",
    "test": "node --test test/*.test.js",
    "test:all": "node --test test/*.test.js ../frontend/test/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "esbuild": "0.24.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
